<?xml version="1.0"?>
<ruleset name="Kochmodus PHP Compatibility">
    <description>Checks PHP cross-version compatibility (PHP 7.4 up to latest).</description>

    <file>kochmodus.php</file>
    <file>uninstall.php</file>
    <file>src/</file>
    <file>config/</file>
    <file>templates/</file>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="ps"/>

    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>

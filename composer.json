{
    "name": "flowd/kochmodus-wordpress-plugin",
    "description": "Kochmodus cooking mode widget for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^7.4|^8.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6",
        "rregeer/phpunit-coverage-check": "^0.3.1",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Kochmodus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kochmodus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=coverage.xml --coverage-html=coverage/html --coverage-text",
            "coverage-check coverage.xml 75"
        ],
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --diff --dry-run",
        "cs:fix": "php-cs-fixer fix --diff"
    },
    "config": {
        "sort-packages": true
    }
}

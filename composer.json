{
    "name": "flowd/kochmodus-wordpress-plugin",
    "description": "Kochmodus cooking mode widget for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^7.4|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Kochmodus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kochmodus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "analyse": "phpstan analyse",
        "cs:fix": "php-cs-fixer fix --diff"
    },
    "config": {
        "sort-packages": true
    }
}
